#!/bin/sh
# T3 probes the executable before starting its ACP stdio transport.
case "$1" in
  --version) echo 'Home23 Jerry 1.0.0' ;;
  status) echo '{"auth":"Home23 over SSH","model":"Jerry","model_source":"home23"}' ;;
  models) echo '{"ids":[]}' ;;
  acp) exec /usr/bin/ssh -T -o BatchMode=yes -o StrictHostKeyChecking=yes -o ConnectTimeout=5 jtr@100.79.10.60 'exec /usr/bin/python3 ~/.local/lib/home23-t3/jerry-acp.py' ;;
  *) exit 2 ;;
esac
