{
  "contractVersion": 1,
  "idFormat": {
    "opaqueEntity": "lowercase prefix plus canonical lowercase UUIDv7",
    "uuidV7Pattern": "[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}",
    "reservedPrincipal": "user_owner",
    "eventCursor": "positive signed 64-bit integer sequence",
    "rules": [
      "IDs never encode mutable names, ports, paths, or provider identifiers",
      "IDs are never recycled",
      "Bot principals use the same bot_ identity as the visible Bot",
      "AuthorityEpoch is sequence-keyed by capability and has no opaque ID"
    ]
  },
  "ids": {
    "home": {"prefix": "home_", "pattern": "^home_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "visibility": "public"},
    "principal": {"prefix": null, "pattern": "^(user_owner|bot_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})$", "visibility": "public"},
    "bot": {"prefix": "bot_", "pattern": "^bot_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "visibility": "public"},
    "channel": {"prefix": "chn_", "pattern": "^chn_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "visibility": "public"},
    "conversation": {"prefix": "cnv_", "pattern": "^cnv_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "visibility": "public", "meaning": "identity projection over exactly one Channel"},
    "message": {"prefix": "msg_", "pattern": "^msg_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "visibility": "public"},
    "artifact": {"prefix": "art_", "pattern": "^art_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "visibility": "public", "meaning": "public Attachment and canonical Artifact identity"},
    "event": {"prefix": "evt_", "pattern": "^evt_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "visibility": "public", "ordering": "integer sequence only"},
    "device": {"prefix": "dev_", "pattern": "^dev_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "visibility": "public"},
    "clientSession": {"prefix": "ses_", "pattern": "^ses_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "visibility": "public"},
    "pairingSession": {"prefix": "pair_", "pattern": "^pair_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "visibility": "public"},
    "round": {"prefix": "rnd_", "pattern": "^rnd_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "visibility": "diagnostic"},
    "work": {"prefix": "wrk_", "pattern": "^wrk_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "visibility": "consequential"},
    "attempt": {"prefix": "att_", "pattern": "^att_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "visibility": "diagnostic"},
    "lease": {"prefix": "lse_", "pattern": "^lse_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "visibility": "internal"},
    "contextManifest": {"prefix": "ctx_", "pattern": "^ctx_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "visibility": "diagnostic"},
    "delivery": {"prefix": "dlv_", "pattern": "^dlv_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "visibility": "diagnostic"},
    "outbox": {"prefix": "obx_", "pattern": "^obx_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "visibility": "internal"},
    "legacySource": {"prefix": "legacy_", "pattern": "^legacy_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "visibility": "diagnostic"},
    "importCohort": {"prefix": "imp_", "pattern": "^imp_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "visibility": "diagnostic"},
    "importItem": {"prefix": "imi_", "pattern": "^imi_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "visibility": "diagnostic"},
    "alias": {"prefix": "alias_", "pattern": "^alias_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "visibility": "internal"},
    "workObservation": {"prefix": "obs_", "pattern": "^obs_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "visibility": "diagnostic"},
    "request": {"prefix": "req_", "pattern": "^req_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "visibility": "public"},
    "correlation": {"prefix": "cor_", "pattern": "^cor_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "visibility": "public"}
  },
  "stateMachines": {
    "botLifecycle": {"states": ["provisioning", "active", "archived", "failed"], "transitions": [["provisioning", "active"], ["provisioning", "failed"], ["failed", "provisioning"], ["active", "archived"], ["archived", "active"]], "terminal": [], "terminalPolicy": "reversible_archive_and_retry"},
    "botAvailability": {"states": ["offline", "starting", "available", "busy", "degraded"], "transitions": [["offline", "starting"], ["starting", "available"], ["starting", "degraded"], ["starting", "offline"], ["available", "busy"], ["available", "degraded"], ["available", "offline"], ["busy", "available"], ["busy", "degraded"], ["busy", "offline"], ["degraded", "available"], ["degraded", "offline"]], "terminal": [], "terminalPolicy": "projection_not_identity"},
    "channel": {"states": ["active", "archived"], "transitions": [["active", "archived"], ["archived", "active"]], "terminal": [], "terminalPolicy": "reversible_archive"},
    "attachment": {"states": ["staging", "ready", "failed", "expired", "deleted"], "transitions": [["staging", "ready"], ["staging", "failed"], ["ready", "expired"], ["ready", "deleted"], ["failed", "deleted"], ["expired", "deleted"]], "terminal": ["deleted"], "terminalPolicy": "deleted_is_immutable"},
    "round": {"states": ["open", "coordinating", "waiting", "completed", "failed", "cancelled"], "transitions": [["open", "coordinating"], ["open", "cancelled"], ["coordinating", "waiting"], ["coordinating", "completed"], ["coordinating", "failed"], ["coordinating", "cancelled"], ["waiting", "coordinating"], ["waiting", "failed"], ["waiting", "cancelled"]], "terminal": ["completed", "failed", "cancelled"], "terminalPolicy": "immutable_with_explicit_reason"},
    "work": {"states": ["queued", "leased", "running", "cancelling", "succeeded", "failed", "cancelled"], "transitions": [["queued", "leased"], ["queued", "cancelled"], ["leased", "running"], ["leased", "queued"], ["running", "succeeded"], ["running", "failed"], ["running", "cancelling"], ["cancelling", "cancelled"]], "terminal": ["succeeded", "failed", "cancelled"], "terminalPolicy": "immutable"},
    "attempt": {"states": ["created", "offered", "accepted", "running", "cancel_requested", "succeeded", "failed", "cancelled", "expired", "rejected", "abandoned"], "transitions": [["created", "offered"], ["created", "abandoned"], ["offered", "accepted"], ["offered", "rejected"], ["accepted", "running"], ["accepted", "expired"], ["running", "succeeded"], ["running", "failed"], ["running", "cancel_requested"], ["cancel_requested", "cancelled"]], "terminal": ["succeeded", "failed", "cancelled", "expired", "rejected", "abandoned"], "terminalPolicy": "immutable_retry_creates_new_attempt"},
    "lease": {"states": ["offered", "active", "released", "expired", "revoked"], "transitions": [["offered", "active"], ["active", "released"], ["active", "expired"], ["active", "revoked"]], "terminal": ["released", "expired", "revoked"], "terminalPolicy": "immutable_fence_invalidated"},
    "messageVisibility": {"states": ["visible", "tombstoned"], "transitions": [["visible", "tombstoned"]], "terminal": ["tombstoned"], "terminalPolicy": "immutable_history_correction_is_new_message"},
    "delivery": {"states": ["pending", "sending", "delivered", "retry_wait", "permanent_failure", "cancelled"], "transitions": [["pending", "sending"], ["pending", "cancelled"], ["sending", "delivered"], ["sending", "retry_wait"], ["sending", "permanent_failure"], ["sending", "cancelled"], ["retry_wait", "sending"], ["retry_wait", "permanent_failure"], ["retry_wait", "cancelled"]], "terminal": ["delivered", "permanent_failure", "cancelled"], "terminalPolicy": "immutable_final_disposition_retained"},
    "outbox": {"states": ["pending", "claimed", "retry", "delivered", "dead_letter"], "transitions": [["pending", "claimed"], ["claimed", "delivered"], ["claimed", "retry"], ["claimed", "dead_letter"], ["retry", "claimed"], ["retry", "dead_letter"]], "terminal": ["delivered", "dead_letter"], "terminalPolicy": "immutable_final_disposition"},
    "clientSession": {"states": ["pairing_pending", "paired", "active", "expired", "revoked", "rotated"], "transitions": [["pairing_pending", "paired"], ["paired", "active"], ["active", "expired"], ["active", "revoked"], ["active", "rotated"]], "terminal": ["expired", "revoked", "rotated"], "terminalPolicy": "immutable_refresh_rotation_creates_successor"},
    "pairingSession": {"states": ["pending", "redeemed", "expired", "locked"], "transitions": [["pending", "redeemed"], ["pending", "expired"], ["pending", "locked"]], "terminal": ["redeemed", "expired", "locked"], "terminalPolicy": "one_use_immutable"},
    "importItem": {"states": ["discovered", "selected", "imported", "verified", "quarantined", "rolled_back", "skipped_with_reason"], "transitions": [["discovered", "selected"], ["selected", "imported"], ["selected", "skipped_with_reason"], ["imported", "verified"], ["imported", "rolled_back"], ["verified", "quarantined"]], "terminal": ["quarantined", "rolled_back", "skipped_with_reason"], "terminalPolicy": "verified_is_stable_but_may_quarantine_on_source_drift"},
    "turnProjection": {"states": ["accepted", "running", "streaming", "background", "stopping", "complete", "stopped", "failed", "attention"], "transitions": [["accepted", "running"], ["accepted", "attention"], ["running", "streaming"], ["running", "background"], ["running", "stopping"], ["running", "complete"], ["running", "failed"], ["running", "attention"], ["streaming", "background"], ["streaming", "stopping"], ["streaming", "complete"], ["streaming", "failed"], ["background", "running"], ["background", "stopping"], ["background", "complete"], ["background", "failed"], ["background", "attention"], ["stopping", "stopped"], ["stopping", "failed"], ["stopping", "attention"], ["attention", "running"], ["attention", "stopping"], ["attention", "complete"], ["attention", "failed"]], "terminal": ["complete", "stopped", "failed"], "terminalPolicy": "projection_terminal_follows_durable_work_truth"},
    "activity": {"states": ["idle", "accepted", "working", "background", "stopping", "attention", "failed"], "transitions": [["idle", "accepted"], ["accepted", "working"], ["accepted", "attention"], ["working", "background"], ["working", "stopping"], ["working", "idle"], ["working", "attention"], ["working", "failed"], ["background", "working"], ["background", "stopping"], ["background", "idle"], ["background", "attention"], ["background", "failed"], ["stopping", "idle"], ["stopping", "attention"], ["stopping", "failed"], ["attention", "working"], ["attention", "idle"]], "terminal": [], "terminalPolicy": "compact_projection_not_authority"},
    "authorityEpoch": {"states": ["legacy", "shadow", "canonical"], "transitions": [["legacy", "shadow"], ["shadow", "canonical"], ["shadow", "legacy"], ["canonical", "legacy"]], "terminal": [], "terminalPolicy": "records_are_immutable"}
  },
  "publicEnums": {
    "principalKind": {"values": ["owner", "bot"], "unknownPolicy": "reject", "unknownAction": "reject_before_command"},
    "channelKind": {"values": ["direct", "group"], "unknownPolicy": "reject", "unknownAction": "reject_before_command"},
    "memberRole": {"values": ["owner", "member"], "unknownPolicy": "reject", "unknownAction": "reject_before_command"},
    "messageKind": {"values": ["text", "system", "result"], "unknownPolicy": "reject", "unknownAction": "reject_before_command"},
    "responderMode": {"values": ["mentions_only", "mention_or_coordinator"], "unknownPolicy": "reject", "unknownAction": "reject_before_command"},
    "responseOrder": {"values": ["parallel", "sequential"], "unknownPolicy": "reject", "unknownAction": "reject_before_command"},
    "authorityMode": {"values": ["legacy", "shadow", "canonical"], "unknownPolicy": "reject", "unknownAction": "reject_authority_change"},
    "eventDurability": {"values": ["durable", "transient"], "unknownPolicy": "reject", "unknownAction": "do_not_advance_cursor"},
    "platform": {"values": ["macos", "ios"], "unknownPolicy": "reject", "unknownAction": "reject_pairing"},
    "connectionMode": {"values": ["local", "vpn"], "unknownPolicy": "preserve", "unknownAction": "diagnostic_attention"},
    "searchCompleteness": {"values": ["complete", "partial", "degraded", "unavailable"], "unknownPolicy": "preserve", "unknownAction": "treat_as_incomplete"},
    "botLifecycle": {"values": ["provisioning", "active", "archived", "failed"], "unknownPolicy": "preserve", "unknownAction": "diagnostic_attention"},
    "botAvailability": {"values": ["offline", "starting", "available", "busy", "degraded"], "unknownPolicy": "preserve", "unknownAction": "diagnostic_attention"},
    "channelLifecycle": {"values": ["active", "archived"], "unknownPolicy": "preserve", "unknownAction": "disable_mutations"},
    "attachmentStatus": {"values": ["staging", "ready", "failed", "expired", "deleted"], "unknownPolicy": "preserve", "unknownAction": "disable_content_access"},
    "roundStatus": {"values": ["open", "coordinating", "waiting", "completed", "failed", "cancelled"], "unknownPolicy": "preserve", "unknownAction": "diagnostic_attention"},
    "workStatus": {"values": ["queued", "leased", "running", "cancelling", "succeeded", "failed", "cancelled"], "unknownPolicy": "preserve", "unknownAction": "diagnostic_attention"},
    "attemptStatus": {"values": ["created", "offered", "accepted", "running", "cancel_requested", "succeeded", "failed", "cancelled", "expired", "rejected", "abandoned"], "unknownPolicy": "preserve", "unknownAction": "diagnostic_attention"},
    "leaseStatus": {"values": ["offered", "active", "released", "expired", "revoked"], "unknownPolicy": "preserve", "unknownAction": "treat_as_not_executable"},
    "messageVisibility": {"values": ["visible", "tombstoned"], "unknownPolicy": "preserve", "unknownAction": "hide_and_diagnose"},
    "deliveryStatus": {"values": ["pending", "sending", "delivered", "retry_wait", "permanent_failure", "cancelled"], "unknownPolicy": "preserve", "unknownAction": "diagnostic_attention"},
    "outboxStatus": {"values": ["pending", "claimed", "retry", "delivered", "dead_letter"], "unknownPolicy": "preserve", "unknownAction": "diagnostic_attention"},
    "clientSessionStatus": {"values": ["pairing_pending", "paired", "active", "expired", "revoked", "rotated"], "unknownPolicy": "preserve", "unknownAction": "treat_as_revoked"},
    "pairingSessionStatus": {"values": ["pending", "redeemed", "expired", "locked"], "unknownPolicy": "preserve", "unknownAction": "disable_redemption"},
    "importItemStatus": {"values": ["discovered", "selected", "imported", "verified", "quarantined", "rolled_back", "skipped_with_reason"], "unknownPolicy": "preserve", "unknownAction": "diagnostic_attention"},
    "activityStatus": {"values": ["idle", "accepted", "working", "background", "stopping", "attention", "failed"], "unknownPolicy": "preserve", "unknownAction": "diagnostic_attention"},
    "eventType": {"values": ["bot.created", "bot.updated", "channel.created", "channel.updated", "conversation.updated", "message.appended", "turn.updated", "activity.updated", "attachment.updated", "unread.updated", "device.updated", "authority.epoch_changed", "import.updated"], "unknownPolicy": "ignore_and_advance_cursor", "unknownAction": "ignore_and_advance_cursor"}
  },
  "featureFlags": {
    "coordination.process.enabled": {"default": false, "effectWhenOff": "process does not advertise product capability"},
    "coordination.public_api.enabled": {"default": false, "effectWhenOff": "no api v1 mutation surface"},
    "coordination.resident.jerry.enabled": {"default": false, "effectWhenOff": "no Jerry resident lease; legacy direct path remains"},
    "coordination.resident.forrest.enabled": {"default": false, "effectWhenOff": "no Forrest resident lease; legacy direct path remains"},
    "coordination.channels.enabled": {"default": false, "effectWhenOff": "no group Channel coordination"},
    "coordination.import.shadow_enabled": {"default": false, "effectWhenOff": "no tail or shadow import"},
    "coordination.search.canonical": {"default": false, "effectWhenOff": "search remains legacy or unavailable"},
    "coordination.apple.mac_cutover": {"default": false, "effectWhenOff": "Mac uses legacy chat"},
    "coordination.apple.iphone_cutover": {"default": false, "effectWhenOff": "iPhone uses legacy chat"},
    "coordination.bot_lifecycle.enabled": {"default": false, "effectWhenOff": "Bot lifecycle creation and controls are not advertised"},
    "coordination.compaction.enabled": {"default": false, "effectWhenOff": "no detail removal"}
  },
  "authorityEpoch": {
    "capabilities": ["messages", "roster", "unread", "search", "attachments", "activity", "bot_lifecycle"],
    "modes": ["legacy", "shadow", "canonical"],
    "mutationPolicy": "append_new_epoch",
    "writerPolicy": "exactly_one_active_writer",
    "flagPolicy": "flags_may_reduce_capability_but_never_transfer_authority",
    "requiredReceiptFields": ["sourceWatermark", "destinationWatermark", "samePathCanary", "driftCount", "activeFlags", "rollbackTarget", "operator", "effectiveAtEventSequence"]
  },
  "protocol": {
    "jsonFields": "camelCase",
    "timestamps": "RFC3339 UTC; fractional seconds accepted",
    "integerSequences": "signed 64-bit non-negative integers",
    "unknownFields": "tolerate_additive",
    "errorEnvelope": {"required": ["code", "message", "retryable", "requestId", "details"], "safeDetailsOnly": true},
    "pagination": {"cursor": "opaque, signed, route/principal/filter/direction bound", "offsets": "prohibited for messages and events", "messageBoundary": "beforeSequence", "eventBoundary": "strictly after integer sequence"},
    "requestCorrelation": {"requestId": "server-assigned req_ UUIDv7", "correlationId": "caller-supplied or server-assigned cor_ UUIDv7", "responseEcho": true, "logs": "IDs retained while private bodies and credentials are redacted"},
    "idempotency": {"header": "Idempotency-Key", "length": {"minimum": 16, "maximum": 128}, "characters": "printable ASCII", "scope": ["principalId", "operation", "key"], "sameDigest": "return original committed response", "differentDigest": "409 idempotency_conflict", "allMutations": true},
    "events": {"durableSequence": "integer global sequence", "resume": "strictly_after", "delivery": "at_least_once", "heartbeatSeconds": 15, "duplicate": "no_op", "gap": "409 cursor_expired with bootstrapRequired", "unknownType": "validate envelope, advance cursor, ignore payload", "malformedEnvelope": "reject without advancing cursor", "transientTypes": ["message.delta"]},
    "compatibility": {"major": 1, "breakingMutation": "prohibited", "contractDelta": "numbered and reviewed by Core and Apple owners", "unknownFields": "accepted", "unknownEnums": "per publicEnums registry"}
  },
  "scope": {
    "channelMembers": "user_owner plus local persistent Bots only",
    "visibleBots": "Jerry, Forrest, and durable specialists with continuing identity and mailbox",
    "temporaryHands": "hidden",
    "residentPrivateContext": "default deny; no generic grant endpoint in v1",
    "network": "loopback plus Tailscale/VPN; no public listener",
    "retention": {"conversations": "retained", "terminalProvenance": "retained", "noisyProgressDays": 30, "deliveryAttemptDetailDays": 90},
    "history": "cohort-based references/provenance with selective bodies; no required full-corpus duplication"
  },
  "apiOperations": {
    "getCapabilities": {"method": "GET", "path": "/api/v1/capabilities", "authorityCapability": null},
    "createPairingSession": {"method": "POST", "path": "/api/v1/pairing/sessions", "authorityCapability": null},
    "redeemPairingSession": {"method": "POST", "path": "/api/v1/pairing/sessions/{pairingSessionId}/redeem", "authorityCapability": null},
    "refreshSession": {"method": "POST", "path": "/api/v1/sessions/refresh", "authorityCapability": null},
    "deleteCurrentSession": {"method": "DELETE", "path": "/api/v1/sessions/current", "authorityCapability": null},
    "getBootstrap": {"method": "GET", "path": "/api/v1/bootstrap", "authorityCapability": null},
    "listBots": {"method": "GET", "path": "/api/v1/bots", "authorityCapability": "roster"},
    "createBot": {"method": "POST", "path": "/api/v1/bots", "authorityCapability": "bot_lifecycle"},
    "getBot": {"method": "GET", "path": "/api/v1/bots/{botId}", "authorityCapability": "roster"},
    "updateBot": {"method": "PATCH", "path": "/api/v1/bots/{botId}", "authorityCapability": "roster"},
    "archiveBot": {"method": "POST", "path": "/api/v1/bots/{botId}/archive", "authorityCapability": "bot_lifecycle"},
    "restoreBot": {"method": "POST", "path": "/api/v1/bots/{botId}/restore", "authorityCapability": "bot_lifecycle"},
    "listChannels": {"method": "GET", "path": "/api/v1/channels", "authorityCapability": "messages"},
    "createChannel": {"method": "POST", "path": "/api/v1/channels", "authorityCapability": "messages"},
    "getChannel": {"method": "GET", "path": "/api/v1/channels/{channelId}", "authorityCapability": "messages"},
    "updateChannel": {"method": "PATCH", "path": "/api/v1/channels/{channelId}", "authorityCapability": "messages"},
    "listConversations": {"method": "GET", "path": "/api/v1/conversations", "authorityCapability": "messages"},
    "listChannelMessages": {"method": "GET", "path": "/api/v1/channels/{channelId}/messages", "authorityCapability": "messages"},
    "appendChannelMessage": {"method": "POST", "path": "/api/v1/channels/{channelId}/messages", "authorityCapability": "messages"},
    "updateReadCursor": {"method": "POST", "path": "/api/v1/channels/{channelId}/read", "authorityCapability": "unread"},
    "getUnread": {"method": "GET", "path": "/api/v1/unread", "authorityCapability": "unread"},
    "createAttachment": {"method": "POST", "path": "/api/v1/attachments", "authorityCapability": "attachments"},
    "getAttachment": {"method": "GET", "path": "/api/v1/attachments/{artifactId}", "authorityCapability": "attachments"},
    "getAttachmentContent": {"method": "GET", "path": "/api/v1/attachments/{artifactId}/content", "authorityCapability": "attachments"},
    "deleteAttachment": {"method": "DELETE", "path": "/api/v1/attachments/{artifactId}", "authorityCapability": "attachments"},
    "search": {"method": "GET", "path": "/api/v1/search", "authorityCapability": "search"},
    "listActivity": {"method": "GET", "path": "/api/v1/activity", "authorityCapability": "activity"},
    "getWork": {"method": "GET", "path": "/api/v1/work/{workId}", "authorityCapability": "activity"},
    "cancelWork": {"method": "POST", "path": "/api/v1/work/{workId}/cancel", "authorityCapability": "messages"},
    "retryWork": {"method": "POST", "path": "/api/v1/work/{workId}/retry", "authorityCapability": "messages"},
    "listEvents": {"method": "GET", "path": "/api/v1/events", "authorityCapability": null}
  }
}
